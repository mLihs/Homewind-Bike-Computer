<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    id="homewind"
    displayName="@string/app_name"
    icon="@drawable/ic_homewind"
    scansDevices="false">

    <DataType
        typeId="homewind"
        displayName="@string/field_status"
        description="@string/field_status_description"
        graphical="true"
        icon="@drawable/ic_homewind" />

    <DataType
        typeId="homewind-control"
        displayName="@string/field_control"
        description="@string/field_control_description"
        graphical="true"
        icon="@drawable/ic_homewind" />

    <DataType
        typeId="homewind-fan"
        displayName="@string/field_fan"
        description="@string/field_fan_description"
        graphical="false"
        icon="@drawable/ic_homewind" />

    <BonusAction
        actionId="plus"
        displayName="@string/action_plus" />

    <BonusAction
        actionId="minus"
        displayName="@string/action_minus" />

    <BonusAction
        actionId="mode"
        displayName="@string/action_mode" />
</ExtensionInfo>
